generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  CUSTOMER
  ADMIN
}

enum NetworkCode {
  SAFARICOM
  AIRTEL
}

enum ProductCategory {
  SMS
  DATA
  VOICE
}

enum PaymentStatus {
  PENDING
  INITIATED
  SUCCEEDED
  FAILED
  REFUND_PENDING
  REFUNDED
}

enum DeliveryStatus {
  NOT_STARTED
  PROCESSING
  DELIVERED
  FAILED
  MANUAL_REVIEW
}

model User {
  id           String               @id @default(cuid())
  fullName     String
  email        String               @unique
  phone        String               @unique
  passwordHash String
  role         Role                 @default(CUSTOMER)
  active       Boolean              @default(true)
  createdAt    DateTime             @default(now())
  updatedAt    DateTime             @updatedAt
  orders       Order[]
  recipients   FavouriteRecipient[]
}

model Network {
  id        String      @id @default(cuid())
  code      NetworkCode @unique
  name      String
  enabled   Boolean     @default(true)
  updatedAt DateTime    @updatedAt
  products  Product[]
}

model Product {
  id              String          @id @default(cuid())
  networkId       String
  network         Network         @relation(fields: [networkId], references: [id])
  providerId      String
  name            String
  category        ProductCategory
  quantity        String
  priceKes        Decimal         @db.Decimal(12, 2)
  validity        String?
  eligibility     Json?
  available       Boolean         @default(false)
  lastCatalogueAt DateTime?
  providerData    Json?
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt
  orders          Order[]

  @@unique([networkId, providerId])
  @@index([networkId, category, available])
}

model Order {
  id                String         @id @default(cuid())
  reference         String         @unique
  userId            String
  user              User           @relation(fields: [userId], references: [id])
  productId         String
  product           Product        @relation(fields: [productId], references: [id])
  recipientPhone    String
  amountKes         Decimal        @db.Decimal(12, 2)
  serviceFeeKes     Decimal        @default(0) @db.Decimal(12, 2)
  totalKes          Decimal        @db.Decimal(12, 2)
  paymentStatus     PaymentStatus  @default(PENDING)
  deliveryStatus    DeliveryStatus @default(NOT_STARTED)
  idempotencyKey    String         @unique
  mpesaCheckoutId   String?        @unique
  mpesaReceipt      String?        @unique
  providerReference String?        @unique
  paidAt            DateTime?
  deliveredAt       DateTime?
  createdAt         DateTime       @default(now())
  updatedAt         DateTime       @updatedAt
  paymentEvents     PaymentEvent[]

  @@index([userId, createdAt])
  @@index([paymentStatus, deliveryStatus])
}

model PaymentEvent {
  id         String   @id @default(cuid())
  orderId    String
  order      Order    @relation(fields: [orderId], references: [id])
  provider   String
  eventId    String   @unique
  eventType  String
  payload    Json
  receivedAt DateTime @default(now())

  @@index([orderId, receivedAt])
}

model FavouriteRecipient {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  name      String
  phone     String
  createdAt DateTime @default(now())

  @@unique([userId, phone])
}

model WhatsappSession {
  id        String   @id @default(cuid())
  phone     String   @unique
  state     Json
  expiresAt DateTime
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([expiresAt])
}
