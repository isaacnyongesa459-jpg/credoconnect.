{
  "name": "credoconnect",
  "version": "2.1.0",
  "private": true,
  "description": "CredoConnect plain HTML/CSS/JavaScript frontend with a Node.js/Express backend.",
  "workspaces": ["server"],
  "scripts": {
    "dev": "npm run dev --workspace=@credo/server",
    "start": "npm run start --workspace=@credo/server",
    "test": "npm run test --workspace=@credo/server",
    "db:generate": "npm run prisma:generate --workspace=@credo/server",
    "db:migrate": "npm run prisma:migrate --workspace=@credo/server"
  }
}
