# Backend runtime settings. Keep real values out of Git and frontend bundles.
PORT=5000
NODE_ENV=development
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DATABASE?sslmode=require
APP_ORIGIN=http://localhost:5000

# Configure only after authorized provider onboarding. Product sales stay unavailable until verified.
BUNDLE_PROVIDER_BASE_URL=
BUNDLE_PROVIDER_API_KEY=
BUNDLE_PROVIDER_WEBHOOK_SECRET=

# WhatsApp Cloud API/webhook verification. The bot remains provider-agnostic here;
# outbound delivery should be configured in the authorized WhatsApp adapter.
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_WEBHOOK_SECRET=
WHATSAPP_SESSION_STORE=database

# Daraja sandbox values only, after reviewing the authorized reference implementation.
MPESA_ENV=sandbox
MPESA_CONSUMER_KEY=
MPESA_CONSUMER_SECRET=
MPESA_PASSKEY=
MPESA_SHORTCODE=
MPESA_CALLBACK_URL=
